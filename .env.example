# ── Obligatorio ──────────────────────────────────────────────────────────────
# La URL ACP del agente. Es su campo `agentUrl` tal cual (wss://…/acp). Sin esto la app no
# intenta conectar: te lo dice en pantalla en vez de dejarte mirando un spinner.
ACP_WS_URL=wss://acp-<agentId>.sandboxes.easybits.cloud/acp

# El token del agente. Sale de crear el agente: es su `embedToken`, salvo que le hayas puesto
# un `ACP_AGENT_TOKEN` propio en el `env`, y entonces es ése.
#
# ⚠️ NO es el GOOSE_SERVER__SECRET_KEY de la caja, como decía este archivo hasta hoy: ése es un
# secreto interno que se regenera en cada arranque y nunca sale de la microVM.
# Se manda como `?token=` en la URL y como `Authorization: Bearer`. Déjalo vacío si tu agente
# ACP no pide credencial.
ACP_TOKEN=

# ── Opcional ─────────────────────────────────────────────────────────────────
# Dónde abre sus sesiones el agente. En una caja ghosty-lite, /data/work es lo que existe y lo
# único que sobrevive a que se duerma; si pones una ruta que no exista dentro, el agente la
# degrada a /data/work sin avisar.
ACP_CWD=/data/work

# Ciclo de vida de la caja (SÓLO EasyBits): despertarla al hablarle y suspenderla al ocio.
# Sin estas dos, esto es un cliente ACP normal contra cualquier proveedor: se conecta, pero no
# despierta nada — el agente tiene que estar ya arriba.
AGENT_BOX_ID=
EASYBITS_API_KEY=

# Para recrear la caja si el host la perdió. Ojo: la caja nueva tiene OTRA URL, así que habrá
# que actualizar ACP_WS_URL a mano.
AGENT_SNAPSHOT_ID=
