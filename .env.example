# Endpoint ACP del agente: la URL que devuelve expose, con wss:// en vez de https://
ACP_WS_URL=wss://sb-<id>-3000.sandboxes.easybits.cloud/acp

# GOOSE_SERVER__SECRET_KEY de la caja del agente. Sin esto, el WSS responde 401.
ACP_SECRET=

# Directorio donde el agente abre sus sesiones (dentro de su caja).
ACP_CWD=/root

# Caja del agente, para el ciclo de vida (despertar al hablarle, suspender al ocio).
AGENT_BOX_ID=

# Llave de EasyBits (Dashboard → Developer). Sin ella la app funciona, pero no
# gestiona la caja: ni extiende el TTL ni la suspende al ocio.
EASYBITS_API_KEY=
